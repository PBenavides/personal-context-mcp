{
  "name": "personal-context-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Pablo's enriched personal context (Obsidian vault + activity events) over streamable HTTP with BM25 search.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/otel": "^0.18.1",
    "@fastify/sensible": "^6.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "config": "^3.3.12",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "qs": "^6.15.2",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/qs": "^6.9.16",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
