{
  "port": "PORT",
  "auth": {
    "bearerToken": "MCP_BEARER_TOKEN"
  },
  "logger": {
    "level": "LOG_LEVEL"
  },
  "connections": {
    "enrichedCorpus": {
      "source": "CORPUS_SOURCE",
      "rootDir": "CORPUS_ROOT",
      "bucket": "CONTEXT_BUCKET",
      "prefix": "CONTEXT_PREFIX",
      "region": "AWS_REGION",
      "refreshSeconds": "REFRESH_SECONDS"
    },
    "vectorSearch": {
      "bucket": "VECTOR_BUCKET",
      "index": "VECTOR_INDEX",
      "region": "AWS_REGION",
      "embedModelId": "EMBED_MODEL_ID"
    },
    "ontology": {
      "source": "ONTOLOGY_SOURCE",
      "rootDir": "ONTOLOGY_ROOT",
      "bucket": "ONTOLOGY_BUCKET",
      "prefix": "ONTOLOGY_PREFIX",
      "region": "AWS_REGION",
      "syncEnabled": "ONTOLOGY_SYNC_ENABLED",
      "maxDocsPerRun": "ONTOLOGY_MAX_DOCS"
    },
    "openRouter": {
      "apiKey": "OPENROUTER_API_KEY",
      "baseUrl": "OPENROUTER_BASE_URL",
      "chatModel": "OPENROUTER_CHAT_MODEL",
      "embedModel": "OPENROUTER_EMBED_MODEL"
    },
    "ynab": {
      "token": "YNAB_TOKEN",
      "baseUrl": "YNAB_BASE_URL"
    },
    "hevy": {
      "apiKey": "HEVY_API_KEY",
      "baseUrl": "HEVY_BASE_URL"
    },
    "googleCalendar": {
      "refreshToken": "GOOGLE_CALENDAR_REFRESH_TOKEN",
      "clientId": "GOOGLE_CLIENT_ID",
      "clientSecret": "GOOGLE_CLIENT_SECRET",
      "baseUrl": "GOOGLE_CALENDAR_BASE_URL"
    },
    "doctolib": {
      "defaultCountry": "DOCTOLIB_COUNTRY",
      "minIntervalMs": "DOCTOLIB_MIN_INTERVAL_MS"
    }
  },
  "security": {
    "dnsRebindingProtection": {
      "__name": "MCP_DNS_REBINDING_PROTECTION",
      "__format": "boolean"
    }
  }
}
