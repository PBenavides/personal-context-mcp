# personal-context-mcp — environment reference (all optional locally; see config/default.json)

# HTTP
PORT=3000
LOG_LEVEL=info

# Auth — static bearer required on MCP routes (from SSM /personal-context/mcp-bearer-token
# in production). Empty = UNAUTHENTICATED, local dev only.
MCP_BEARER_TOKEN=

# Corpus source: "file" (local dir, credential-free) or "s3" (production)
CORPUS_SOURCE=file
CORPUS_ROOT=tests/fixtures/enriched

# S3 source (CORPUS_SOURCE=s3). Credentials via the default AWS chain:
# task role in production, AWS_PROFILE/AWS_ACCESS_KEY_ID locally.
CONTEXT_BUCKET=personal-pbenavides
CONTEXT_PREFIX=context-enriched/
AWS_REGION=us-east-1
# AWS_PROFILE=personal

# Manifest run_id re-check interval in seconds (0 disables background refresh)
REFRESH_SECONDS=300

# --- Ontology layer (see docs/ontologies.md) ---

# Registry source: "file" (local dir, credential-free) or "s3" (production)
ONTOLOGY_SOURCE=file
ONTOLOGY_ROOT=data/ontology
ONTOLOGY_BUCKET=personal-pbenavides
ONTOLOGY_PREFIX=ontology/

# Hourly injector cron at minute :00 (the ontology_sync tool always works on demand)
ONTOLOGY_SYNC_ENABLED=false
# Per-run cap on documents routed through the LLM
ONTOLOGY_MAX_DOCS=25

# OpenRouter (injector LLM + ontology_search embeddings). SECRET — .env locally,
# SSM /personal-context/openrouter-api-key in production. Empty disables the
# injector; ontology_search falls back to keyword ranking.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# --- personal-tools MCP (see docs/personal-tools.md) ---

# YNAB personal access token (https://app.ynab.com/settings/developer). SECRET —
# .env locally, SSM /personal-context/ynab-token in production. Empty disables
# the ynab_* tools.
YNAB_TOKEN=

# Hevy API key (https://hevy.com/settings?developer, requires Hevy Pro). SECRET —
# .env locally, SSM /personal-context/hevy-api-key in production. Empty disables
# the hevy_* tools.
HEVY_API_KEY=

# Google Calendar OAuth (refresh-token flow, see docs/personal-tools.md for how to mint
# GOOGLE_CALENDAR_REFRESH_TOKEN once via the browser flow). All three SECRET — .env
# locally, SSM /personal-context/google-{client-id,client-secret,calendar-refresh-token}
# in production. Any one empty disables the gcal_* tools.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Doctolib (doctolib_* tools in personal-tools). No credentials - anonymous reads of the
# patient frontend's JSON API. Default site when a tool omits `country` (de|fr|it), and
# the per-host throttle between requests.
DOCTOLIB_COUNTRY=de
DOCTOLIB_MIN_INTERVAL_MS=600
