# personal-context-mcp — environment reference (all optional locally; see config/default.json)

# HTTP
PORT=3000
LOG_LEVEL=info

# Auth — static bearer required on MCP routes (from SSM /personal-context/mcp-bearer-token
# in production). Empty = UNAUTHENTICATED, local dev only.
MCP_BEARER_TOKEN=

# Corpus source: "file" (local dir, credential-free) or "s3" (production)
CORPUS_SOURCE=file
CORPUS_ROOT=tests/fixtures/enriched

# S3 source (CORPUS_SOURCE=s3). Credentials via the default AWS chain:
# task role in production, AWS_PROFILE/AWS_ACCESS_KEY_ID locally.
CONTEXT_BUCKET=personal-pbenavides
CONTEXT_PREFIX=context-enriched/
AWS_REGION=us-east-1
# AWS_PROFILE=personal

# Manifest run_id re-check interval in seconds (0 disables background refresh)
REFRESH_SECONDS=300
